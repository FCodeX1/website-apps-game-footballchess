function emptyStats() { return { shots: 0, onTarget: 0, goals: 0, passes: 0, passOk: 0, tackles: 0, tackleOk: 0, fouls: 0, yellows: 0, reds: 0, corners: 0, offsides: 0, possession: 0, injuries: 0, xg: 0 }; }
