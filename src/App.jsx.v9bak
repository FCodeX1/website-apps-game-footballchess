function managerFromPreset(key) {
  const c = COACH_PRESETS.find((x) => x.key === key) || COACH_PRESETS[0];
  return { name: c.name, style: c.style, reputation: c.reputation, boardTrust: c.boardTrust, fanTrust: c.fanTrust };
}

