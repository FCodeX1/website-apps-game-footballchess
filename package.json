{
  "name": "bola-catur-arena-v23-super-landscape-league-roster",
  "private": true,
  "version": "23.0.0",
  "type": "module",
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host 0.0.0.0 --force",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview --host 0.0.0.0",
    "lan": "npm run build && node server/lan-server.js",
    "lan:server": "node server/lan-server.js",
    "qa": "npm run qa:static && npm run qa:full",
    "build:qa": "npm run build && npm run qa",
    "qa:static": "node scripts/qa-check.mjs",
    "qa:full": "node scripts/full-qa.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "5.4.19"
  }
}